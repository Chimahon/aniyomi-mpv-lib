+// Snapshot layout-owned text before the next event reuses RenderContext.
+static void capture_text_geometry(RenderContext *state, EventImages *images)
+{
+    if (!state->renderer->geometry_enabled)
+        return;
+    TextInfo *text = &state->text_info;
+    uint32_t *symbols = calloc(text->length, sizeof(*symbols));
+    ASS_TextGeometrySpan *spans = calloc(text->length, sizeof(*spans));
+    if (!symbols || !spans) {
+        free(symbols); free(spans);
+        return;  // Geometry allocation must never affect rendering.
+    }
+    int count = 0;
+    for (int i = 0; i < text->length; i++) {
+        GlyphInfo *root = &text->glyphs[i];
+        symbols[i] = root->source_symbol;
+        if (root->skip || root->drawing_text.str)
+            continue;
+        int end = i + 1;
+        while (end < text->length && text->glyphs[end].skip &&
+               !text->glyphs[end].is_trimmed_whitespace &&
+               !text->glyphs[end].drawing_text.str &&
+               text->glyphs[end].source_symbol != '\n')
+            end++;
+        int x0 = INT_MAX, y0 = INT_MAX, x1 = INT_MIN, y1 = INT_MIN;
+        for (GlyphInfo *g = root; g; g = g->next) {
+            if (g->hit_w <= 0 || g->hit_h <= 0)
+                continue;
+            x0 = FFMIN(x0, g->hit_x); y0 = FFMIN(y0, g->hit_y);
+            x1 = FFMAX(x1, g->hit_x + g->hit_w);
+            y1 = FFMAX(y1, g->hit_y + g->hit_h);
+        }
+        if (x1 > x0 && y1 > y0)
+            spans[count++] = (ASS_TextGeometrySpan) {i, end, x0, y0, x1-x0, y1-y0};
+    }
+    images->geometry = (ASS_TextGeometryEvent) {
+        .start = images->event->Start, .duration = images->event->Duration,
+        .read_order = images->event->ReadOrder, .layer = images->event->Layer,
+        .text = symbols, .text_length = text->length,
+        .spans = spans, .span_count = count,
+    };
+}
