+static void filter_event_text(RenderContext *state)
+{
+    ASS_Renderer *renderer = state->renderer;
+    TextInfo *text = &state->text_info;
+    int length = text->length;
+    if (!renderer->text_filter || !length)
+        return;
+    // ASS drawings are not text, and must retain their exact drawing runs.
+    for (int i = 0; i < length; i++)
+        if (text->glyphs[i].drawing_text.str)
+            return;
+    uint32_t *input = calloc(length, sizeof(*input));
+    uint32_t *output = calloc(length, sizeof(*output));
+    int *indices = calloc(length, sizeof(*indices));
+    if (!input || !output || !indices)
+        goto done;
+    for (int i = 0; i < length; i++)
+        input[i] = text->glyphs[i].symbol;
+    int count = renderer->text_filter(renderer->text_filter_opaque, input, length, output);
+    if (count < 0 || count > length)
+        goto done;
+    // Only deletion and whitespace normalization are supported. Validate the
+    // entire mapping before touching glyphs; malformed output leaves ASS intact.
+    int source = 0;
+    for (int i = 0; i < count; i++) {
+        while (source < length && input[source] != output[i] &&
+               !(output[i] == ' ' && (input[source] == '\n' ||
+                 input[source] == '\t' || input[source] == 0xA0)))
+            source++;
+        if (source == length)
+            goto done;
+        indices[i] = source++;
+    }
+    for (int i = 0; i < count; i++) {
+        text->glyphs[i] = text->glyphs[indices[i]];
+        text->glyphs[i].symbol = output[i];
+        text->glyphs[i].source_symbol = output[i];
+    }
+    text->length = count;
+done:
+    free(input); free(output); free(indices);
+}
