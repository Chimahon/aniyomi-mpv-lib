+void ass_visit_text_geometry(ASS_Renderer *renderer,
+    void (*visit)(void *, const ASS_TextGeometryEvent *), void *opaque)
+{
+    for (int i = 0; i < renderer->geometry_event_count; i++) {
+        const ASS_TextGeometryEvent *event = &renderer->eimg[i].geometry;
