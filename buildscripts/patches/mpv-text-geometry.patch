+static void append_text_geometry(void *opaque, const ASS_TextGeometryEvent *src)
+{
+    struct sub_text_geometry *geometry = opaque;
+    struct sub_text_event event = {
+        .id = src->read_order, .layer = src->layer,
+        .start = src->start / 1000.0, .end = (src->start + src->duration) / 1000.0,
+    };
+    int *offsets = talloc_array(NULL, int, src->text_length + 1);
+    bstr text = {0};
+    int offset = 0;
+    for (int i = 0; i < src->text_length; i++) {
+        unsigned cp = src->text[i];
+        offsets[i] = offset;
+        offset += cp > 0xFFFF ? 2 : 1;
+        char utf8[4];
+        int n;
+        if (cp < 0x80) { utf8[0] = cp; n = 1; }
+        else if (cp < 0x800) {
+            utf8[0] = 0xC0 | (cp >> 6); utf8[1] = 0x80 | (cp & 63); n = 2;
+        } else if (cp < 0x10000) {
+            utf8[0] = 0xE0 | (cp >> 12); utf8[1] = 0x80 | ((cp >> 6) & 63);
+            utf8[2] = 0x80 | (cp & 63); n = 3;
+        } else {
+            utf8[0] = 0xF0 | (cp >> 18); utf8[1] = 0x80 | ((cp >> 12) & 63);
+            utf8[2] = 0x80 | ((cp >> 6) & 63); utf8[3] = 0x80 | (cp & 63); n = 4;
+        }
+        bstr_xappend(NULL, &text, (bstr) {utf8, n});
+    }
+    offsets[src->text_length] = offset;
+    event.text = talloc_strndup(geometry, text.start ? text.start : "", text.len);
+    event.spans = talloc_array(geometry, struct sub_text_span, src->span_count);
+    for (int i = 0; i < src->span_count; i++) {
+        const ASS_TextGeometrySpan *span = &src->spans[i];
+        if (span->h <= 0 || span->w <= 0)
+            continue;
+        event.spans[event.num_spans++] = (struct sub_text_span) {
+            offsets[span->start], offsets[span->end], span->x, span->y, span->w, span->h,
+        };
+    }
+    MP_TARRAY_APPEND(geometry, geometry->events, geometry->num_events, event);
+    talloc_free(text.start);
+    talloc_free(offsets);
+}
+
+static struct sub_text_geometry *get_text_geometry(struct sd *sd,
+    struct mp_osd_res dim, double pts)
+{
+    struct sd_ass_priv *ctx = sd->priv;
+    if (!ctx->ass_renderer || dim.w <= 0 || dim.h <= 0 || pts == MP_NOPTS_VALUE)
+        return NULL;
+    // Render and snapshot while the decoder lock is held. Geometry and text
+    // therefore belong to exactly the same frame, including collision shifts.
+    struct sub_bitmaps *images = get_bitmaps(sd, dim, SUBBITMAP_LIBASS, pts);
+    talloc_free(images);
+    struct sub_text_geometry *geometry = talloc_zero(NULL, struct sub_text_geometry);
+    geometry->w = dim.w; geometry->h = dim.h;
+    ass_visit_text_geometry(ctx->ass_renderer, append_text_geometry, geometry);
+    return geometry;
+}
