+struct sub_text_geometry *sub_get_text_geometry(struct dec_sub *sub,
+    struct mp_osd_res dim, double pts)
+{
+    mp_mutex_lock(&sub->lock);
+    struct sub_text_geometry *geometry = NULL;
+    if (sub->sd->driver->get_text_geometry) {
+        geometry = sub->sd->driver->get_text_geometry(sub->sd, dim,
+            pts_to_subtitle(sub, pts));
+        for (int i = 0; geometry && i < geometry->num_events; i++) {
+            geometry->events[i].start = pts_from_subtitle(sub, geometry->events[i].start);
+            geometry->events[i].end = pts_from_subtitle(sub, geometry->events[i].end);
+        }
+    }
+    mp_mutex_unlock(&sub->lock);
+    return geometry;
+}
