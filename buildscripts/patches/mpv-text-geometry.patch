+static int mp_property_sub_text_geometry(void *ctx, struct m_property *prop,
+    int action, void *arg)
+{
+    if (action == M_PROPERTY_GET_TYPE) {
+        *(struct m_option *)arg = (struct m_option){.type = CONF_TYPE_STRING};
+        return M_PROPERTY_OK;
+    }
+    if (action != M_PROPERTY_GET)
+        return M_PROPERTY_NOT_IMPLEMENTED;
+    MPContext *mpctx = ctx;
+    int index = *(int *)prop->priv;
+    struct track *track = mpctx->current_track[index][STREAM_SUB];
+    struct dec_sub *sub = track ? track->d_sub : NULL;
+    if (!sub || mpctx->playback_pts == MP_NOPTS_VALUE)
+        return M_PROPERTY_UNAVAILABLE;
+    struct sub_text_geometry *geometry = sub_get_text_geometry(sub,
+        osd_get_vo_res(mpctx->osd), mpctx->playback_pts);
+    if (!geometry)
+        return M_PROPERTY_UNAVAILABLE;
+    struct mpv_node root;
+    node_init(&root, MPV_FORMAT_NODE_MAP, NULL);
+    node_map_add_int64(&root, "version", 1);
+    node_map_add_int64(&root, "w", geometry->w);
+    node_map_add_int64(&root, "h", geometry->h);
+    struct mpv_node *events = node_map_add(&root, "events", MPV_FORMAT_NODE_ARRAY);
+    for (int i = 0; i < geometry->num_events; i++) {
+        struct sub_text_event *src = &geometry->events[i];
+        struct mpv_node *event = node_array_add(events, MPV_FORMAT_NODE_MAP);
+        node_map_add_string(event, "text", src->text);
+        node_map_add_int64(event, "id", src->id);
+        node_map_add_double(event, "start", src->start);
+        node_map_add_double(event, "end", src->end);
+        struct mpv_node *spans = node_map_add(event, "spans", MPV_FORMAT_NODE_ARRAY);
+        for (int j = 0; j < src->num_spans; j++) {
+            struct sub_text_span *s = &src->spans[j];
+            struct mpv_node *span = node_array_add(spans, MPV_FORMAT_NODE_MAP);
+            node_map_add_int64(span, "start", s->start);
+            node_map_add_int64(span, "end", s->end);
+            node_map_add_int64(span, "x", s->x); node_map_add_int64(span, "y", s->y);
+            node_map_add_int64(span, "w", s->w); node_map_add_int64(span, "h", s->h);
+        }
+    }
+    char *json = NULL;
+    int result = json_write(&json, &root);
+    talloc_free(root.u.list);
+    talloc_free(geometry);
+    if (result < 0) { talloc_free(json); return M_PROPERTY_ERROR; }
+    *(char **)arg = json;
+    return M_PROPERTY_OK;
+}
